<UserControl x:Class="LocalRack.Views.ProjectTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LocalRack.Converters">
    <UserControl.Resources>
        <conv:ServiceStatusToBrushConverter x:Key="ServiceStatusToBrushConverter" />
        <conv:ServiceStatusToLabelConverter x:Key="ServiceStatusToLabelConverter" />
        <ContextMenu x:Key="ServiceContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Edit…" Click="EditServiceMenuItem_OnClick" />
            <Separator />
            <MenuItem Header="Delete Service" Click="DeleteServiceMenuItem_OnClick" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="250" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
            <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Services" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StartAllButton" Content="Start All" Margin="0,0,6,0"
                            Style="{StaticResource ButtonStyle}" Click="StartAllButton_OnClick" />
                    <Button x:Name="StopAllButton" Content="Stop All" Margin="0,0,6,0"
                            Style="{StaticResource ButtonStyle}" Click="StopAllButton_OnClick" />
                    <Button Content="Add Service" Style="{StaticResource ButtonStyle}"
                            Click="AddServiceButton_OnClick" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Margin="12,8" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="No services yet. Use &quot;Add Service&quot; to define one." />
            <ListBox x:Name="ServicesListBox" Margin="6,0,6,6" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ServicesListBox_OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10" Margin="2,0,10,0" VerticalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource ServiceStatusToBrushConverter}}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Padding="8,2" FontSize="11" Margin="6,0,0,0"
                                    VerticalAlignment="Center" MinWidth="48"
                                    Style="{StaticResource ButtonStyle}"
                                    Content="{Binding Status, Converter={StaticResource ServiceStatusToLabelConverter}}"
                                    Click="ServiceToggleButton_OnClick" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemStyle}">
                        <EventSetter Event="MouseDoubleClick" Handler="ServiceItem_OnMouseDoubleClick" />
                        <Setter Property="ContextMenu" Value="{StaticResource ServiceContextMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}" />

        <DockPanel Grid.Column="2" Margin="10">
            <Grid x:Name="LogHeader" DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="LogTitleText" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding Name, FallbackValue='Select a service to view logs'}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                <!-- Full width under the title so long commands/paths wrap instead of hiding behind the buttons.
                     Read-only TextBoxes so the values can be selected and copied. -->
                <Grid x:Name="DetailsGrid" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style x:Key="DetailLabel" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="Margin" Value="0,1,10,0" />
                        </Style>
                        <Style x:Key="DetailValue" TargetType="TextBox">
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="IsReadOnly" Value="True" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Command" Style="{StaticResource DetailLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Command, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder" Style="{StaticResource DetailLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DirectoryPath, Mode=OneWay}" Style="{StaticResource DetailValue}" />
                </Grid>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button x:Name="EditServiceButton" Content="Edit" Margin="0,0,6,0" IsEnabled="False"
                            Style="{StaticResource ButtonStyle}" Click="EditServiceButton_OnClick" />
                    <Button x:Name="DeleteServiceButton" Content="Delete" Margin="0,0,6,0" IsEnabled="False"
                            Style="{StaticResource ButtonStyle}" Click="DeleteServiceButton_OnClick" />
                    <Button x:Name="ClearLogsButton" Content="Clear Logs" IsEnabled="False"
                            Style="{StaticResource ButtonStyle}" Click="ClearLogsButton_OnClick" />
                </StackPanel>
            </Grid>

            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <RichTextBox x:Name="LogView" IsReadOnly="True" IsUndoEnabled="False"
                             Background="{StaticResource ConsoleBackgroundBrush}"
                             Foreground="{StaticResource ConsoleTextBrush}"
                             FontFamily="Consolas" FontSize="12" BorderThickness="0" Padding="4"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             SelectionBrush="#3B82F6"
>
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </RichTextBox.Resources>
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                            <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                    <FlowDocument PagePadding="2" />
                </RichTextBox>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
