<UserControl x:Class="LocalRack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel Margin="24,20" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Image Source="{StaticResource LogoImage}" Width="40" Height="40" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Theme" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="System follows your Windows light/dark setting and changes with it." />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystemRadio" Content="System" GroupName="Theme"
                                         Style="{StaticResource SegmentedButtonStyle}" Checked="ThemeRadio_OnChecked" />
                            <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="Theme"
                                         Style="{StaticResource SegmentedButtonStyle}" Checked="ThemeRadio_OnChecked" />
                            <RadioButton x:Name="ThemeDarkRadio" Content="Dark" GroupName="Theme"
                                         Style="{StaticResource SegmentedButtonStyle}" Checked="ThemeRadio_OnChecked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Start LocalRack with Windows" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Open LocalRack automatically when you sign in. Services are not started automatically." />
                        <TextBlock x:Name="StartupNoteText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <CheckBox x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Start LocalRack with Windows"
                              Checked="StartupToggle_OnChanged" Unchecked="StartupToggle_OnChanged" />
                </Grid>
            </Border>

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Keep running in the system tray" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Minimizing or closing the window hides LocalRack to the tray and your services keep running. Use Exit in the tray icon's menu to quit and stop all services. With this and Start with Windows both on, LocalRack starts quietly in the tray." />
                    </StackPanel>
                    <CheckBox x:Name="TrayToggle" Grid.Column="1" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Keep running in the system tray"
                              Checked="TrayToggle_OnChanged" Unchecked="TrayToggle_OnChanged" />
                </Grid>
            </Border>

            <TextBlock Text="UPDATES" FontSize="11" FontWeight="SemiBold" Margin="0,20,0,6"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Check for updates when LocalRack starts" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="Looks for a newer release on GitHub and asks before installing it. Nothing is installed without your confirmation." />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="CheckNowButton" Content="Check now" Style="{StaticResource ButtonStyle}"
                                    Padding="12,4" Click="CheckNowButton_OnClick" />
                            <TextBlock x:Name="UpdateStatusText" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox x:Name="UpdateToggle" Grid.Column="1" VerticalAlignment="Top"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Check for updates when LocalRack starts"
                              Checked="UpdateToggle_OnChanged" Unchecked="UpdateToggle_OnChanged" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
