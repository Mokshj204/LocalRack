<UserControl x:Class="LocalRack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBackgroundBrush}">
        <StackPanel Margin="24,20" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Image Source="{StaticResource LogoImage}" Width="40" Height="40" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Start LocalRack with Windows" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Open LocalRack automatically when you sign in. Services are not started automatically." />
                        <TextBlock x:Name="StartupNoteText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}" Visibility="Collapsed" />
                    </StackPanel>
                    <CheckBox x:Name="StartupToggle" Grid.Column="1" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Start LocalRack with Windows"
                              Checked="StartupToggle_OnChanged" Unchecked="StartupToggle_OnChanged" />
                </Grid>
            </Border>

            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Keep running in the system tray" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Minimizing or closing the window hides LocalRack to the tray and your services keep running. Use Exit in the tray icon's menu to quit and stop all services. With this and Start with Windows both on, LocalRack starts quietly in the tray." />
                    </StackPanel>
                    <CheckBox x:Name="TrayToggle" Grid.Column="1" VerticalAlignment="Center"
                              Style="{StaticResource ToggleSwitchStyle}"
                              AutomationProperties.Name="Keep running in the system tray"
                              Checked="TrayToggle_OnChanged" Unchecked="TrayToggle_OnChanged" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
